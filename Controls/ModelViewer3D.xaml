<UserControl x:Class="PlaneLoadoutWpfTest.Controls.ModelViewer3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             ClipToBounds="True">

    <!-- ══════════════════════════════════════════════════════════════════════
         ModelViewer3D — self-contained 3-D preview panel.

         Placeholder state  : animated rotating cube, dark-studio background.
         Production state   : swap BuildPlaceholderModel() for OBJ/FBX loader,
                              replace BackdropRect with an HDR env-sphere mesh.

         DependencyProperties exposed to XAML callers:
           ModelLabel  (string) — corner label, e.g. "AIRCRAFT" / "PILOT"
           SubLabel    (string) — secondary line, e.g. current model name
    ══════════════════════════════════════════════════════════════════════════ -->

    <Grid>

        <!-- ═══ Layer 1 — HDR placeholder backdrop ═══════════════════════════
             A radial gradient that mimics a softbox-lit studio environment.
             Replace the gradient with a spherical HDR mesh later.           -->
        <Rectangle x:Name="BackdropRect">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38"
                                     RadiusX="0.75" RadiusY="0.65">
                    <GradientStop Color="#182430" Offset="0.0"/>
                    <GradientStop Color="#0E161E" Offset="0.55"/>
                    <GradientStop Color="#050A0E" Offset="1.0"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══ Layer 2 — 3-D Viewport ══════════════════════════════════════ -->
        <Viewport3D x:Name="Viewport"
                    MouseLeftButtonDown="Viewport_MouseDown"
                    MouseMove="Viewport_MouseMove"
                    MouseLeftButtonUp="Viewport_MouseUp"
                    MouseWheel="Viewport_MouseWheel"
                    Cursor="SizeAll">

            <Viewport3D.Camera>
                <!-- Camera position is computed in code; only FieldOfView is set here. -->
                <PerspectiveCamera x:Name="Camera"
                                   FieldOfView="42"
                                   NearPlaneDistance="0.05"
                                   FarPlaneDistance="1000"/>
            </Viewport3D.Camera>

            <!-- ── Studio lighting: 3-point setup ─────────────────────────── -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <!-- Ambient: very dim fill to stop shadows being pure black -->
                        <AmbientLight Color="#1E2428"/>

                        <!-- Key: warm soft-box, top-front-right -->
                        <DirectionalLight Color="#EED4A8" Direction="0.38,-0.72,0.58"/>

                        <!-- Fill: cool blue from left-back, lower intensity -->
                        <DirectionalLight Color="#3A5878" Direction="-0.55,0.32,-0.40"/>

                        <!-- Rim: warm amber from far-back-right — separates
                             silhouette from the dark background               -->
                        <DirectionalLight Color="#786028" Direction="-0.80,0.10,-0.60"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- ── Model slot — geometry is injected from code ────────────── -->
            <ModelVisual3D x:Name="ModelContainer"/>

        </Viewport3D>

        <!-- ═══ Layer 3 — Corner HUD overlays ═══════════════════════════════ -->

        <!-- Top-left: model type label -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="14,10" IsHitTestVisible="False">
            <TextBlock x:Name="ModelLabelBlock"
                       Text="AIRCRAFT"
                       FontFamily="Georgia" FontSize="12" FontWeight="SemiBold"
                       Foreground="#80C7A066"/>
            <TextBlock x:Name="SubLabelBlock"
                       Text="Placeholder model"
                       FontFamily="Segoe UI" FontSize="10"
                       Foreground="#50F2E7D7" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Bottom-right: interaction hint -->
        <TextBlock Text="Drag to orbit  ·  Scroll to zoom"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,12,8"
                   FontFamily="Segoe UI" FontSize="10"
                   Foreground="#38F2E7D7"
                   IsHitTestVisible="False"/>

        <!-- Bottom-left: placeholder notice (hidden when real model loaded) -->
        <TextBlock x:Name="PlaceholderNotice"
                   Text="[ cube placeholder — model asset pending ]"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="12,0,0,8"
                   FontFamily="Segoe UI" FontSize="10"
                   Foreground="#30F2E7D7"
                   IsHitTestVisible="False"/>

    </Grid>
</UserControl>
