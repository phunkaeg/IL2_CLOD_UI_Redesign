<Window x:Class="PlaneLoadoutWpfTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PlaneLoadoutWpfTest"
        Title="IL-2 Sturmovik: Cliffs of Dover"
        Width="1280" Height="800"
        MinWidth="1180" MinHeight="680"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        MouseMove="Window_MouseMove"
        Background="#0A0C0D">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <RadialGradientBrush Center="0.65,0.12" RadiusX="1.05" RadiusY="0.9">
                <GradientStop Color="#1E292D" Offset="0"/>
                <GradientStop Color="#101618" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- ═══ LAYER 1 — Photographic background (blurred / far away) ════
             Blur softens the photo so the blueprint stays sharp and readable.
             Parallax coefficient is small — this layer feels distant.         -->
        <Rectangle IsHitTestVisible="False" Opacity="0.22">
            <Rectangle.Fill>
                <ImageBrush ImageSource="Assets/bg_photo.png" Stretch="UniformToFill"
                            AlignmentX="Center" AlignmentY="Center"/>
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="5"/>
            </Rectangle.Effect>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="BackgroundParallax"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- ═══ LAYER 2 — Blueprint overlay (sharper / closer) ════
             No blur — the crisp blueprint lines contrast nicely against
             the softened background. Parallax coefficient is larger so it
             visibly slides in front of the photo on mouse movement.           -->
        <Rectangle Fill="{StaticResource BlueprintBrush}" IsHitTestVisible="False">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="BlueprintParallax"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- ═══ LAYER 3 — Reactive point-light (radial glow) ════
             Follows the mouse as a warm amber spotlight.                       -->
        <Rectangle IsHitTestVisible="False" Opacity="0.55">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                     RadiusX="0.52" RadiusY="0.44">
                    <GradientStop Color="#26D5C6AA" Offset="0"/>
                    <GradientStop Color="#0E7A6A54" Offset="0.50"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="LightTransform"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- ═══ LAYER 4 — Directional sheen (dynamic lighting) ════
             A wide linear gradient whose angle rotates with the mouse,
             simulating the whole scene tilting under a raking light source.
             Keep opacity very low so it reads as environmental, not intrusive. -->
        <Rectangle IsHitTestVisible="False" Opacity="0.09">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="LightGradientAngle"
                                         CenterX="0.5" CenterY="0.5" Angle="0"/>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#55C8B890" Offset="0.00"/>
                    <GradientStop Color="#20907060" Offset="0.38"/>
                    <GradientStop Color="#00000000" Offset="0.70"/>
                    <GradientStop Color="#0C000000" Offset="1.00"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══ LAYER 5 — Vignette ════ -->
        <Rectangle Fill="{StaticResource VignetteBrush}" IsHitTestVisible="False"/>

        <!-- ═══ LAYER 6 — Screen host ════ -->
        <ContentPresenter x:Name="ScreenHost" Content="{Binding CurrentScreen}"/>

        <!-- ═══ LAYER 7 — Settings overlay (hidden until gear is clicked) ════ -->
        <local:SettingsOverlay x:Name="SettingsOverlay" Visibility="Collapsed"/>

        <!-- ═══ LAYER 8 — Gear button (always on top of everything) ════
             Small, unobtrusive; sits in the top-right corner.
             The ToolTip reminds players what it does.                    -->
        <Button x:Name="GearButton"
                Content="⚙"
                Width="40" Height="40"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,14,18,0"
                Padding="0"
                FontFamily="Segoe UI Symbol"
                FontSize="18"
                Opacity="0.65"
                ToolTip="UI Overhaul Settings — set mission folder paths"
                Click="Gear_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1.0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</Window>
