<UserControl x:Class="PlaneLoadoutWpfTest.Screens.CampaignScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlaneLoadoutWpfTest.Screens"
             xmlns:svc="clr-namespace:PlaneLoadoutWpfTest.Services">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="CampaignTemplate" DataType="{x:Type svc:CampaignBoardCampaign}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource LabelText}" FontSize="11" Opacity="0.72"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="TimelineTemplate" DataType="{x:Type local:CampaignTimelineItem}">
                <Border BorderBrush="{StaticResource BorderBrushMuted}"
                        BorderThickness="1" Background="#99101516" Padding="10,8">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource LabelText}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource LabelText}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextGoldBrush}"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,24,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource LabelText}" FontSize="11"
                                   Opacity="0.78" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="MissionTemplate" DataType="{x:Type svc:CampaignMission}">
                <Border x:Name="Card" MinHeight="68" Margin="0,0,0,8" BorderBrush="{StaticResource BorderBrushMuted}"
                        BorderThickness="1" Background="#AA151A1D" Padding="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◷" Style="{StaticResource SubtitleText}" FontSize="16"
                                       FontWeight="SemiBold" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding DisplayTime}" Style="{StaticResource SubtitleText}" FontWeight="SemiBold"
                                       FontSize="18"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Type}" Style="{StaticResource LabelText}"
                                   Foreground="{StaticResource TextGoldBrush}" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding RoleSummary}" Style="{StaticResource LabelText}"
                                   FontSize="10.5" TextTrimming="CharacterEllipsis"
                                   Opacity="0.82" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding LockStatus}" Style="{StaticResource LabelText}"
                                   FontSize="10.5" Foreground="{StaticResource TextGoldBrush}"
                                   FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter TargetName="Card" Property="Opacity" Value="0.55"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="RoleTemplate" DataType="{x:Type svc:CampaignRole}">
                <Border x:Name="RoleCard" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1" Background="#66101516"
                        Padding="9" Margin="0,0,0,8" MinHeight="68">
                    <StackPanel>
                        <TextBlock Text="{Binding Unit}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Aircraft}" Style="{StaticResource LabelText}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Side}" Style="{StaticResource LabelText}" FontSize="11"
                                   Foreground="{StaticResource TextGoldBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="RAF">
                        <Setter TargetName="RoleCard" Property="Background" Value="#77203120"/>
                        <Setter TargetName="RoleCard" Property="BorderBrush" Value="#668EAD81"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Side}" Value="Luftwaffe">
                        <Setter TargetName="RoleCard" Property="Background" Value="#77202A31"/>
                        <Setter TargetName="RoleCard" Property="BorderBrush" Value="#667B91A3"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Side}" Value="Regia Aeronautica">
                        <Setter TargetName="RoleCard" Property="Background" Value="#772C2B20"/>
                        <Setter TargetName="RoleCard" Property="BorderBrush" Value="#66A99D67"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="RouteTemplate" DataType="{x:Type svc:CampaignRoute}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="74"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Side}" Style="{StaticResource LabelText}" Foreground="{StaticResource TextGoldBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Display}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Formation}" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SlideTemplate" DataType="{x:Type svc:CampaignSlide}">
                <Border BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1"
                        Background="#66101516" Padding="8" Margin="0,0,10,10" Width="220">
                    <StackPanel>
                        <Image Source="{Binding Src}" Height="110" Stretch="UniformToFill"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SectionName}" Style="{StaticResource LabelText}"
                                   FontSize="11" Opacity="0.72"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="146"/>
            <RowDefinition Height="196"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118"/>
                <ColumnDefinition Width="760"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="570"/>
            </Grid.ColumnDefinitions>
            <Border Width="102" Height="102" HorizontalAlignment="Left" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1" Background="#66101516">
                <Image x:Name="SideInsigniaImage" Width="88" Height="88" Stretch="Uniform" Opacity="0.92"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="CampaignTitleText" Text="CAMPAIGN BOARD" Style="{StaticResource ScreenTitle}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CampaignStatusText" Style="{StaticResource LabelText}" Opacity="0.78" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="3" x:Name="MetReportWidget" Style="{StaticResource GlassPanel}" Padding="12" Margin="0,18"
                    ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="MET REPORT" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"
                               HorizontalAlignment="Center"/>
                    <Border Width="42" Height="42" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1"
                            Background="#664C3F1B" HorizontalAlignment="Center">
                        <TextBlock x:Name="WeatherIconText" Text="WX" FontSize="19" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextGoldBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="5" Style="{StaticResource GlassPanel}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="OPERATIONS FILTER" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SideFilterCombo" SelectionChanged="Filter_Changed"/>
                        <ComboBox Grid.Column="2" x:Name="GroupFilterCombo" SelectionChanged="Filter_Changed"/>
                        <ComboBox Grid.Column="4" x:Name="MapFilterCombo" SelectionChanged="Filter_Changed"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TypeFilterCombo" SelectionChanged="Filter_Changed"/>
                        <ComboBox Grid.Column="2" x:Name="AircraftFilterCombo" SelectionChanged="Filter_Changed"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="10" Margin="0,8,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="0"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimelineHeaderText" Text="CAMPAIGN TIMELINE" Style="{StaticResource PanelTitle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                        <Button x:Name="TimelineDaysButton" Content="DAYS" Width="86" Height="34"
                                Style="{StaticResource OkButton}" Click="TimelineDays_Click"/>
                        <Button x:Name="TimelineTimesButton" Content="TIMES" Width="86" Height="34"
                                Margin="8,0,0,0" Click="TimelineTimes_Click"/>
                    </StackPanel>
                    <ListBox Grid.Column="2" x:Name="CampaignList" Height="0" Width="0"
                             Visibility="Collapsed"
                             ItemTemplate="{StaticResource CampaignTemplate}"
                             SelectionChanged="CampaignList_SelectionChanged"/>
                </Grid>
                <ListBox Grid.Row="1" x:Name="DayList" BorderThickness="0" Background="Transparent"
                         ItemTemplate="{StaticResource TimelineTemplate}"
                         Height="116"
                         ScrollViewer.HorizontalScrollBarVisibility="Visible"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingPanel.IsVirtualizing="False"
                         PreviewMouseWheel="DayList_PreviewMouseWheel"
                         SelectionChanged="DayList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Width" Value="250"/>
                            <Setter Property="Height" Value="84"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TimeColumn" Width="18*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="FlightsColumn" Width="18*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="42*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="TimePanelBorder" Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedDayText" Text="SELECTED DAY" Style="{StaticResource PanelTitle}"/>
                    <TextBox Grid.Row="1" x:Name="SearchBox" HorizontalContentAlignment="Left"
                             TextChanged="Filter_Changed" ToolTip="Search squadron, Gruppe, aircraft, briefing"
                             Margin="0,0,0,12"/>
                    <ListBox Grid.Row="2" x:Name="MissionList" BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource MissionTemplate}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="SmoothVerticalList_PreviewMouseWheel"
                             SelectionChanged="MissionList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </Border>

            <Border x:Name="FlightsPanelBorder" Grid.Column="2" Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="AVAILABLE FLIGHTS" Style="{StaticResource PanelTitle}"/>
                    <ListBox Grid.Row="1" x:Name="RoleList" BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource RoleTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="SmoothVerticalList_PreviewMouseWheel"
                             SelectionChanged="RoleList_SelectionChanged"
                             Margin="0,10,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="MissionTitleText" Text="Select a mission" Style="{StaticResource TitleText}"
                                   FontSize="28" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MissionMetaText" Text="Campaign detail panel" Style="{StaticResource LabelText}"
                                   Foreground="{StaticResource TextGoldBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TabControl Grid.Row="1" Margin="0,12,0,0">
                        <TabItem Header="OVERVIEW">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="BRIEFING SNAPSHOT" Style="{StaticResource PanelTitle}"/>
                                    <TextBlock x:Name="BriefingSummaryText" TextWrapping="Wrap" Style="{StaticResource BodyText}"
                                               LineHeight="20"/>
                                    <TextBlock Text="ROUTES" Style="{StaticResource PanelTitle}" Margin="0,20,0,10"/>
                                    <ListBox x:Name="RouteList" ItemTemplate="{StaticResource RouteTemplate}" MaxHeight="170"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="BRIEFING">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                                <TextBlock x:Name="FullBriefingText" TextWrapping="Wrap" Style="{StaticResource BodyText}"
                                           LineHeight="20"/>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="GALLERY">
                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1" Background="#AA060809" MinHeight="280">
                                    <Grid>
                                        <Image x:Name="GalleryImage" Stretch="Uniform"/>
                                        <TextBlock x:Name="GalleryEmptyText" Text="No gallery images found for this mission."
                                                   Style="{StaticResource LabelText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="PREV" Width="82" Height="34" Click="GalleryPrev_Click"/>
                                    <StackPanel Grid.Column="1" Margin="14,0">
                                        <TextBlock x:Name="GalleryTitleText" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="GalleryCaptionText" Style="{StaticResource LabelText}" Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock x:Name="GalleryCounterText" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="NEXT" Width="82" Height="34" Click="GalleryNext_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="PILOT LOG">
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="PILOT'S LOG" Style="{StaticResource PanelTitle}"/>
                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Result" Style="{StaticResource LabelText}"/>
                                            <ComboBox x:Name="PilotResultCombo"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Landing" Style="{StaticResource LabelText}"/>
                                            <ComboBox x:Name="PilotLandingCombo"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Air claims" Style="{StaticResource LabelText}"/>
                                            <TextBox x:Name="PilotAirClaimsBox" Text="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Ground / shipping claims" Style="{StaticResource LabelText}"/>
                                            <TextBox x:Name="PilotGroundClaimsBox" Text="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                        <TextBlock Text="Damage / remarks" Style="{StaticResource LabelText}"/>
                                        <TextBox x:Name="PilotDamageBox" Text="None recorded"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                        <TextBlock Text="Pilot notes" Style="{StaticResource LabelText}"/>
                                        <TextBox x:Name="PilotNotesBox" AcceptsReturn="True" Height="150"
                                                 VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="SAVE LOG ENTRY" Width="150" Height="38" Style="{StaticResource OkButton}" Click="SavePilotLog_Click"/>
                                        <Button Content="AUTOFILL" Width="110" Height="38" Margin="10,0,0,0" Click="AutofillPilotLog_Click"/>
                                        <TextBlock x:Name="PilotLogStatusText" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1"
                                        Background="#66101516" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="RECENT ENTRIES" Style="{StaticResource PanelTitle}"/>
                                        <ListBox Grid.Row="1" x:Name="PilotLogList" Margin="0,12,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="NAVIGATION MAP" Style="{StaticResource PanelTitle}"/>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1" Background="#AA060809">
                        <Canvas x:Name="MapViewport" ClipToBounds="True" Background="#22000000"
                                SizeChanged="MapViewport_SizeChanged"
                                MouseWheel="MapViewport_MouseWheel"
                                MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
                                MouseMove="MapViewport_MouseMove"
                                MouseLeftButtonUp="MapViewport_MouseLeftButtonUp">
                            <Image x:Name="MapImage" Stretch="Fill"/>
                            <Canvas x:Name="RouteCanvas" IsHitTestVisible="True" SizeChanged="RouteCanvas_SizeChanged"/>
                            <StackPanel Orientation="Horizontal" Canvas.Right="10" Canvas.Top="10">
                                <Button Content="FIT" Width="54" Height="30" Click="MapFit_Click"/>
                                <Button Content="+" Width="34" Height="30" Margin="8,0,0,0" Click="MapZoomIn_Click"/>
                                <Button Content="-" Width="34" Height="30" Margin="8,0,0,0" Click="MapZoomOut_Click"/>
                            </StackPanel>
                        </Canvas>
                    </Border>
                    <TextBlock Grid.Row="2" x:Name="MapHintText" Style="{StaticResource LabelText}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrushMuted}"
                BorderThickness="1" Background="#88161C1F">
            <Grid Margin="18,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <Button Content="BACK" Height="38" Click="Back_Click"/>
                <TextBlock Grid.Column="1" x:Name="SourcePathText" Style="{StaticResource LabelText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" x:Name="UnlockCampaignsButton" Content="UNLOCK CAMPAIGNS"
                        Height="38" Margin="12,0,0,0" Click="UnlockCampaigns_Click"/>
            </Grid>
        </Border>

        <Border x:Name="LoadingOverlay" Grid.RowSpan="4" Visibility="Collapsed"
                Background="#D006090A" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="PARSING DATA" Style="{StaticResource ScreenTitle}" FontSize="32"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingOverlayText" Text="Scanning campaigns, briefings, routes and images..."
                           Style="{StaticResource LabelText}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
