<UserControl x:Class="PlaneLoadoutWpfTest.Screens.QuickMissionScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlaneLoadoutWpfTest"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ── Screen title ──────────────────────────────────────────────── -->
        <TextBlock Grid.Row="0" Text="QUICK MISSION"
                   Style="{StaticResource ScreenTitle}" VerticalAlignment="Center"/>

        <!-- ── Environment bar ──────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#22161C1F"
                BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">

                <!-- Time (HH : MM) — rotary drum spinners -->
                <TextBlock Text="Time (local):" Style="{StaticResource LabelText}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <local:DrumSpinner x:Name="HourSpinner"
                                   Minimum="0" Maximum="23" Step="1" Value="9"
                                   Width="64" VerticalAlignment="Center"/>
                <TextBlock Text=":" Foreground="{StaticResource TextGoldBrush}"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="4,0"/>
                <local:DrumSpinner x:Name="MinuteSpinner"
                                   Minimum="0" Maximum="55" Step="5" Value="0"
                                   Width="64" VerticalAlignment="Center"/>

                <!-- Weather preset -->
                <TextBlock Text="Weather:" Style="{StaticResource LabelText}"
                           VerticalAlignment="Center" Margin="18,0,8,0"/>
                <ComboBox x:Name="WeatherCombo" Width="190" VerticalAlignment="Center"
                          SelectionChanged="WeatherCombo_SelectionChanged"
                          ToolTip="{Binding ElementName=WeatherCombo, Path=SelectedItem.Tag}"/>

                <!-- Cloud Base kft — shown only when weather has clouds -->
                <StackPanel x:Name="CloudBasePanel" Orientation="Horizontal"
                            Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Cloud base:" Style="{StaticResource LabelText}"
                               VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <local:DrumSpinner x:Name="CloudBaseSpinner"
                                       Minimum="1" Maximum="30" Step="1" Value="6"
                                       Width="80"/>
                    <TextBlock Text=" kft" Style="{StaticResource LabelText}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ── Three-panel content ──────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT — Mission list ════════════════════════════════ -->
            <Border Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with browse button -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MISSIONS" Style="{StaticResource PanelTitle}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse…" Height="26"
                                FontSize="11" Padding="8,0"
                                Click="BrowseMissions_Click"
                                ToolTip="Scan a Cliffs of Dover missions folder for .mis files"/>
                    </Grid>

                    <!-- Map / theatre filter -->
                    <ComboBox x:Name="MapFilterCombo" Grid.Row="1"
                              SelectedIndex="0" Margin="0,0,0,6"
                              SelectionChanged="MapFilter_SelectionChanged">
                        <ComboBoxItem Content="All theatres"/>
                        <ComboBoxItem Content="English Channel"/>
                        <ComboBoxItem Content="Tobruk / Western Desert"/>
                    </ComboBox>

                    <!-- Separator -->
                    <Rectangle Grid.Row="2" Height="1"
                               Fill="{StaticResource BorderBrushMuted}" Margin="0,0,0,6"/>

                    <!-- Mission list -->
                    <ListBox x:Name="MissionList" Grid.Row="3"
                             SelectionChanged="MissionList_SelectionChanged"/>

                    <TextBlock x:Name="EmptyMissionHint" Grid.Row="3"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="12" Opacity="0.45"
                               Style="{StaticResource BodyText}"
                               Text="Scanning configured Quick Mission folders..."/>
                </Grid>
            </Border>

            <!-- ═══ CENTRE — Aircraft selection ════════════════════════ -->
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="SELECT YOUR AIRCRAFT"
                               Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>

                    <!-- Side filter -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Side:" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SideFilterCombo" Width="120"
                                  SelectionChanged="SideFilter_SelectionChanged">
                            <ComboBoxItem Content="Allies" IsSelected="True"/>
                            <ComboBoxItem Content="Axis"/>
                        </ComboBox>
                        <TextBlock Text="Role:" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox x:Name="RoleFilterCombo" Width="110"
                                  SelectionChanged="RoleFilter_SelectionChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Fighter"/>
                            <ComboBoxItem Content="Bomber"/>
                            <ComboBoxItem Content="Attacker"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Aircraft list box -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="1" Background="#18101516">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="AircraftListBox"
                                     SelectionChanged="Aircraft_SelectionChanged"/>

                            <!-- Count / loadout strip -->
                            <Grid Grid.Row="1" Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Planes:" Style="{StaticResource LabelText}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="PlaneCountCombo"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                </ComboBox>
                                <TextBlock Grid.Column="2"/>
                                <TextBlock Grid.Column="3" Text="Loadout:"
                                           Style="{StaticResource LabelText}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="4" SelectedIndex="0">
                                    <ComboBoxItem Content="Default"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ RIGHT — Mission detail ══════════════════════════════ -->
            <Border Grid.Column="4" Style="{StaticResource GlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- title -->
                        <RowDefinition Height="140"/>    <!-- image -->
                        <RowDefinition Height="Auto"/>   <!-- meta grid -->
                        <RowDefinition Height="*"/>      <!-- scrollable body -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock x:Name="MissionTitleLabel"
                               Text="Channel Sweep"
                               Style="{StaticResource PanelTitle}" FontSize="16"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- Mission image (hidden when no image available) -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="1" Background="#20101516"
                            ClipToBounds="True" Margin="0,0,0,10">
                        <Grid>
                            <Image x:Name="DetailImage" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NoImageHint"
                                       Text="NO MISSION IMAGE" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Style="{StaticResource LabelText}"
                                       Opacity="0.25"/>
                        </Grid>
                    </Border>

                    <!-- Compact meta: map / time / theatre in one row -->
                    <Grid x:Name="MissionMetaGrid" Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Map:"  Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="MissionMapLabel" Grid.Column="1"
                                   Text="English Channel" Style="{StaticResource BodyText}" Margin="0,0,14,0"/>
                        <TextBlock Text="Time:" Grid.Column="2" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="MissionTimeLabel" Grid.Column="3"
                                   Text="—" Style="{StaticResource BodyText}"/>
                    </Grid>

                    <!-- Scrollable body: description + plane groups + start info -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock x:Name="MissionDescLabel"
                                       TextWrapping="Wrap" Margin="0,0,0,14"
                                       Style="{StaticResource BodyText}" Opacity=".82"
                                       Text="A routine sweep over the English Channel. Engage any enemy aircraft encountered and return to base."/>

                            <TextBlock Text="PLANE GROUPS" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>

                            <!-- Table header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Side"     Style="{StaticResource LabelText}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Aircraft" Style="{StaticResource LabelText}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Qty"  Style="{StaticResource LabelText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrushMuted}" Margin="0,4,0,4"/>

                            <!-- Static placeholder row — replaced at runtime for scanned missions -->
                            <Grid x:Name="PlaneGroupRow1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PGSide1"     Text="RAF"           Style="{StaticResource BodyText}"/>
                                <TextBlock x:Name="PGAircraft1" Grid.Column="1" Text="Hurricane Mk I" Style="{StaticResource BodyText}"/>
                                <TextBlock x:Name="PGQty1"      Grid.Column="2" Text="4" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Start area + altitude -->
                            <Grid Margin="0,14,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Starting Area:" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StartAreaLabel" Grid.Column="1"
                                           Text="Biggin Hill" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Altitude:" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AltitudeLabel" Grid.Column="3"
                                           Text="3 000 m" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer ────────────────────────────────────────────────────── -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrushMuted}"
                BorderThickness="1" Background="#88161C1F">
            <Grid Margin="18,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <Button Content="← BACK" Height="38" Click="Back_Click"/>
                <Button Grid.Column="1" Content="REALISM" Height="38" Margin="10,0,0,0"
                        Click="Realism_Click"/>
                <Button Grid.Column="3" Content="SAVE AS…" Height="38" Margin="0,0,10,0"
                        ToolTip="Save this mission setup as a named preset"/>
                <Button Grid.Column="4" Content="FLY →" Height="38"
                        Style="{StaticResource OkButton}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
