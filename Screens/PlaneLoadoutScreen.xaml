<UserControl x:Class="PlaneLoadoutWpfTest.Screens.PlaneLoadoutScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlaneLoadoutWpfTest"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Roundel -->
            <Grid Width="42" Height="42" VerticalAlignment="Center">
                <Image Source="{Binding RoundelImagePath}" Stretch="Uniform"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="PLANE LOADOUT OPTIONS" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Hurricane I (Rotol 100 oct)" Style="{StaticResource SubtitleText}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Resolution picker -->
            <ComboBox Grid.Column="2" Width="238" Height="36" VerticalAlignment="Bottom" Margin="0,0,0,10"
                      SelectedIndex="{Binding SelectedResolutionIndex}"
                      SelectionChanged="ResolutionCombo_SelectionChanged">
                <ComboBoxItem Content="1366 × 768"/>
                <ComboBoxItem Content="1600 × 900"/>
                <ComboBoxItem Content="1920 × 1080  [default]"/>
                <ComboBoxItem Content="2560 × 1440"/>
                <ComboBoxItem Content="Windowed test size"/>
            </ComboBox>
        </Grid>

        <!-- ── Tabs ───────────────────────────────────────────────── -->
        <TabControl x:Name="LoadoutTabs" Grid.Row="1" SelectedIndex="0"
                    SelectionChanged="LoadoutTabs_SelectionChanged" Margin="0,0,0,-1">
            <TabItem Header="Weapon Sets"/>
            <TabItem Header="Guns"/>
            <TabItem Header="Bombs  🔒" IsEnabled="False"/>
        </TabControl>

        <!-- ── Tab content area ───────────────────────────────────── -->
        <Grid Grid.Row="2">

            <!-- ══════════════════════════════════════════
                 WEAPON SETS tab
                 ══════════════════════════════════════════ -->
            <Border x:Name="WeaponSetsContent"
                    BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1"
                    Background="#33161C1F" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.18*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Weapon slots panel -->
                    <Border Style="{StaticResource GlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="WEAPON SETS" Style="{StaticResource PanelTitle}" Grid.ColumnSpan="2"/>
                            <TextBlock Grid.Row="1" Text="Slot"   Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Weapon" Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>

                            <Border Grid.Row="2" Grid.ColumnSpan="2"
                                    Background="#55101516" BorderBrush="#2A3031" BorderThickness="0,1,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Wing Guns" Style="{StaticResource BodyText}" FontSize="17" Margin="12,0"/>
                                    <ComboBox Grid.Column="1" Margin="8,5" SelectedIndex="0">
                                        <ComboBoxItem Content="8x Browning .303 Mk. II"/>
                                        <ComboBoxItem Content="No guns"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="3" Text="Bomb Rack"  Style="{StaticResource BodyText}" Opacity="0.45" Margin="12,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Unavailable for this aircraft" Style="{StaticResource BodyText}" Opacity="0.45" Margin="12,0"/>
                            <TextBlock Grid.Row="4" Text="Drop Tank"  Style="{StaticResource BodyText}" Opacity="0.45" Margin="12,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Unavailable" Style="{StaticResource BodyText}" Opacity="0.45" Margin="12,0"/>
                        </Grid>
                    </Border>

                    <!-- Weapons preset panel -->
                    <Border Grid.Column="2" Style="{StaticResource GlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="WEAPONS PRESET" Style="{StaticResource PanelTitle}"/>
                            <ComboBox Grid.Row="1" SelectedIndex="0">
                                <ComboBoxItem Content="Default [Stock]"/>
                                <ComboBoxItem Content="Clean Training"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                            <Grid Grid.Row="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Save"/>
                                <Button Grid.Column="2" Content="Save As…"/>
                                <Button Grid.Column="4" Content="Delete" Style="{StaticResource DangerButton}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Fuel + summary panel -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Style="{StaticResource GlassPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.02*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Fuel -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="FUEL LOAD" Style="{StaticResource PanelTitle}"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Fuel" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FuelPercent}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FuelPercent, StringFormat={}{0:0}%}"
                                               Style="{StaticResource BodyText}"
                                               FontSize="18" HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Grid.Row="2" BorderBrush="#33403F" BorderThickness="1"
                                        Background="#70101516" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Empty weight [kg]"   Style="{StaticResource BodyText}" Opacity=".75"/>
                                        <TextBlock Grid.Column="1" Text="2331" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="1" Text="Pilot weight [kg]" Style="{StaticResource BodyText}" Opacity=".75"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="90" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="2" Text="Loadout weight [kg]" Style="{StaticResource BodyText}" Opacity=".75"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="176" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="3" Text="Fuel weight [kg]"   Style="{StaticResource BodyText}" Opacity=".75"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{Binding FuelWeight}"
                                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="4" Text="Current weight [kg]" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Text="{Binding CurrentWeight}"
                                                   Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource TextGoldBrush}"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="5" Text="Takeoff weight [kg]" Style="{StaticResource BodyText}" Opacity=".75"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1"
                                                   Text="{Binding TakeoffWeight}"
                                                   Style="{StaticResource BodyText}" Opacity=".75" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Aircraft summary -->
                            <Border Grid.Column="2" BorderBrush="#33403F" BorderThickness="1"
                                    Background="#54101516" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="AIRCRAFT SUMMARY" Style="{StaticResource PanelTitle}"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="290"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Border BorderBrush="#384443" BorderThickness="1"
                                                Background="#300C1012" Padding="10" Margin="0,0,8,0">
                                            <local:GunPositionDiagram/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hurricane I" Style="{StaticResource BodyText}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="Rotol 100 octane" Style="{StaticResource BodyText}" Opacity=".75" Margin="0,4,0,12"/>
                                            <TextBlock Text="Wing guns: 8 × Browning .303 Mk. II" Style="{StaticResource BodyText}"/>
                                            <TextBlock Text="Fuel: adjustable before sortie" Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                                            <TextBlock Text="Bombs: unavailable for this aircraft" Style="{StaticResource BodyText}" Opacity=".75" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 GUNS tab
                 ══════════════════════════════════════════ -->
            <Border x:Name="GunsContent" Visibility="Collapsed" Opacity="0"
                    BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1"
                    Background="#33161C1F" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="36*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="32*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Gun selector ──────────────────────────────── -->
                    <Border Style="{StaticResource GlassPanel}">
                        <StackPanel>
                            <TextBlock Text="1 / 8" Style="{StaticResource BodyText}" FontSize="16" Opacity=".85"/>
                            <DockPanel Margin="0,10,0,8">
                                <TextBlock Text="Weapon 1:" Style="{StaticResource LabelText}" Width="80"/>
                                <ComboBox SelectedIndex="0">
                                    <ComboBoxItem Content="Browning .303 Mk. II"/>
                                </ComboBox>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Content="‹ Previous gun"/>
                                <Button Grid.Column="2" Content="Next gun ›"/>
                            </Grid>
                            <ComboBox Margin="0,8,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="Main belt"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- ── Convergence panel ─────────────────────────── -->
                    <Border Grid.Column="2" Style="{StaticResource GlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="CONVERGENCE" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>

                            <CheckBox Grid.Row="1" Content="Default convergence"
                                      IsChecked="{Binding DefaultConvergence}"/>

                            <!-- Everything below the checkbox greys out when DefaultConvergence=True -->
                            <Grid Grid.Row="2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefaultConvergence}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Opacity"   Value="0.35"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="38"/>
                                </Grid.RowDefinitions>

                                <!-- Convergence diagram (silhouette drawn in code) -->
                                <Border BorderBrush="#374443" BorderThickness="1"
                                        Background="#2D0F1315" Margin="0,6,0,8" Padding="6">
                                    <local:ConvergenceDiagram
                                        HorizontalConvergence="{Binding HorizontalConvergence}"
                                        VerticalConvergence="{Binding VerticalConvergence}"/>
                                </Border>

                                <!-- Horizontal convergence -->
                                <Grid Grid.Row="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Horiz." Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                    <local:DrumSpinner Grid.Column="1" Margin="4,0"
                                                       Value="{Binding HorizontalConvergence}"
                                                       Minimum="50" Maximum="800" Step="25"/>
                                    <TextBlock Grid.Column="2" Text="yd"
                                               Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>

                                <!-- Vertical convergence -->
                                <Grid Grid.Row="2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}" VerticalAlignment="Center">
                                        <Run Text="Vert."/>
                                        <Run Text=" ↑elev" Foreground="#7A9080" FontSize="10"/>
                                    </TextBlock>
                                    <local:DrumSpinner Grid.Column="1" Margin="4,0"
                                                       Value="{Binding VerticalConvergence}"
                                                       Minimum="50" Maximum="800" Step="25"/>
                                    <TextBlock Grid.Column="2" Text="yd"
                                               Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ── Preset panel ──────────────────────────────── -->
                    <Border Grid.Column="4" Style="{StaticResource GlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="PRESET" Style="{StaticResource PanelTitle}"/>
                            <ComboBox Grid.Row="1" SelectedIndex="0">
                                <ComboBoxItem Content="Default [Stock]"/>
                                <ComboBoxItem Content="Attack — AP Heavy"/>
                                <ComboBoxItem Content="Attack — Incendiary Mix"/>
                                <ComboBoxItem Content="Night Ops — Tracer Dimmed"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                            <Grid Grid.Row="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Save"/>
                                <Button Grid.Column="2" Content="Save As…"/>
                                <Button Grid.Column="4" Content="Delete" Style="{StaticResource DangerButton}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Main Belt list -->
                    <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="MAIN BELT" Style="{StaticResource PanelTitle}"/>
                            <ListBox x:Name="MainBeltListBox" Grid.Row="1"
                                     ItemsSource="{Binding MainBeltItems}"/>
                        </Grid>
                    </Border>

                    <!-- Belt action buttons -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <Button Content="← INSERT" Click="BeltInsert_Click"
                                ToolTip="Insert selected bullet type into the belt at the selected position"/>
                        <Button Content="ADD +" Margin="0,8,0,0" Click="BeltAdd_Click"
                                ToolTip="Append selected bullet type to the end of the belt"/>
                        <Button Content="REMOVE ×" Margin="0,8,0,0" Click="BeltRemove_Click"
                                ToolTip="Remove selected entry from the belt"/>
                        <Button Content="⟳ DEFAULT" Margin="0,8,0,0" Click="BeltDefault_Click"
                                ToolTip="Reset belt to default factory configuration"/>
                    </StackPanel>

                    <!-- Bullets reference list -->
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource GlassPanel}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="BULLETS" Style="{StaticResource PanelTitle}"/>
                            <ListBox x:Name="BulletsListBox" Grid.Row="1"
                                     ItemsSource="{Binding BulletOptions}"
                                     ItemTemplate="{StaticResource BulletTemplate}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer bar ─────────────────────────────────────────── -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrushMuted}"
                BorderThickness="1" Background="#88161C1F">
            <Grid>
                <Rectangle Fill="{StaticResource RivetsBrush}"/>
                <Grid Margin="18,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="← BACK" Width="146" Height="38" HorizontalAlignment="Left"
                            Click="Back_Click"/>
                    <TextBlock Grid.Column="1" Text="✦" FontSize="23"
                               Foreground="{StaticResource TextGoldBrush}" HorizontalAlignment="Center"/>
                    <Button Grid.Column="2" Content="OK" Width="170" Height="38"
                            HorizontalAlignment="Right" Style="{StaticResource OkButton}"
                            Click="Ok_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
