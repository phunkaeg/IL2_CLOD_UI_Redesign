<UserControl x:Class="PlaneLoadoutWpfTest.Screens.LocalServerScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlaneLoadoutWpfTest">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="LOCAL SERVER" Style="{StaticResource ScreenTitle}" VerticalAlignment="Center"/>

        <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="0,8,0,8"
                VerticalAlignment="Top" MaxWidth="680" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="SERVER OPTIONS" Style="{StaticResource PanelTitle}"/>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Game Description" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Column="1" Text="IL-2 Cliffs of Dover" HorizontalContentAlignment="Left"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Column="1" Text="My Server" HorizontalContentAlignment="Left"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Info" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Column="1" Height="60" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalContentAlignment="Top"
                             HorizontalContentAlignment="Left"
                             Text="Welcome to my server. Have fun and fly safe!"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Security" Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Column="1" SelectedIndex="0">
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="Password"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Max Players" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Column="1" Text="255" HorizontalContentAlignment="Left"/>
                </Grid>

                <TextBlock Text="INSTALLED DLC / GAME PARTS" Style="{StaticResource PanelTitle}" Margin="0,16,0,6"/>

                <!-- DLC toggle rows: friendly name + internal module tag -->
                <Border BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,0,0,1" Padding="0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="True" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Cliffs of Dover (Base Game)"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="core.100" FontFamily="Consolas" FontSize="10"
                                       Foreground="#50F2E7D7"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Required" Foreground="#60C8A050"
                                   FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <Border BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,0,0,1" Padding="0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="True" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Battle of Britain (1940 Theatre)"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="bob.100" FontFamily="Consolas" FontSize="10"
                                       Foreground="#50F2E7D7"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="False" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Desert War — Tobruk (1941 Theatre)"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="tobruk.100" FontFamily="Consolas" FontSize="10"
                                       Foreground="#50F2E7D7"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushMuted}"
                BorderThickness="1" Background="#88161C1F">
            <Grid Margin="18,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <Button Content="← CANCEL" Height="38" Click="Back_Click"/>
                <Button Grid.Column="1" Content="NET OPTIONS" Height="38" Margin="8,0,0,0"
                        Click="NetOptions_Click"/>
                <Button Grid.Column="2" Content="REALISM" Height="38" Margin="8,0,0,0"
                        Click="Realism_Click"/>
                <Button Grid.Column="4" Content="START SERVER" Height="38"
                        Style="{StaticResource OkButton}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
