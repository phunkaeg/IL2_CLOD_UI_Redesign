<UserControl x:Class="PlaneLoadoutWpfTest.Screens.MainMenuScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlaneLoadoutWpfTest"
             MouseMove="UserControl_MouseMove">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ── LAYER 0 — Solid cover: hides all MainWindow blueprint/photo layers ── -->
        <Rectangle Fill="#FF050709"/>

        <!-- ── LAYER 1 — Background2.jpg cinematic background ── -->
        <Image Source="/Assets/Background2.jpg"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5"
               HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.45" ScaleY="1.45"/>
                    <TranslateTransform x:Name="MenuBackgroundParallax"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Rectangle IsHitTestVisible="False" Opacity="0.45">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                     RadiusX="0.48" RadiusY="0.42">
                    <GradientStop Color="#24D5C6AA" Offset="0"/>
                    <GradientStop Color="#0C7A6A54" Offset="0.50"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="MenuLightTransform"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- ── LAYER 2 — Deep left vignette so menu text stays legible ── -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F0030508" Offset="0.00"/>
                    <GradientStop Color="#C8030508" Offset="0.30"/>
                    <GradientStop Color="#88030508" Offset="0.55"/>
                    <GradientStop Color="#00000000" Offset="0.88"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ── LAYER 3 — Bottom vignette ── -->
        <Rectangle IsHitTestVisible="False" VerticalAlignment="Bottom" Height="220">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#88000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ── LAYER 4 — Menu panel ── -->
        <StackPanel Width="500" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="48,0,0,0">

            <!-- Game logo -->
            <Grid HorizontalAlignment="Left" Margin="20,0,0,0">
                <Image x:Name="LogoGlow"
                       Source="/Assets/Cliffs_of_Dover_logo2_glow.png"
                       Stretch="Uniform"
                       MaxHeight="140"
                       Opacity="0.42"
                       IsHitTestVisible="False"/>
                <Image Source="/Assets/Cliffs_of_Dover_logo2.png"
                       Stretch="Uniform"
                       MaxHeight="140"
                       HorizontalAlignment="Left"/>
            </Grid>

            <!-- Separator line -->
            <Rectangle Height="1" Fill="{StaticResource BorderBrushWarm}"
                       Margin="20,22,40,18"/>

            <!-- Main menu buttons -->
            <Button Style="{StaticResource MainMenuItem}" Content="SINGLE PLAYER"
                    Click="SinglePlayer_Click"/>
            <Button Style="{StaticResource MainMenuItem}" Content="MULTIPLAYER"
                    Click="Multiplayer_Click"/>
            <Button Style="{StaticResource MainMenuItem}" Content="OPTIONS"
                    Click="Options_Click"/>
            <Button Style="{StaticResource MainMenuItem}" Content="MANUALS"
                    ToolTip="Opens manuals folder"/>
            <Button Style="{StaticResource MainMenuItem}" Content="EXTRAS"
                    Click="Extras_Click"/>
            <Button Style="{StaticResource MainMenuItem}" Content="EXIT"
                    Click="Exit_Click"/>

            <!-- Build tag -->
            <TextBlock Text="Funk UI overhaul concept"
                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                       Margin="24,22,0,0" Opacity="0.55"/>
        </StackPanel>
    </Grid>
</UserControl>
