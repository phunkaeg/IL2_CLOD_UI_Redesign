<UserControl x:Class="PlaneLoadoutWpfTest.Screens.CreateServerScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CREATE SERVER" Style="{StaticResource ScreenTitle}" VerticalAlignment="Center"/>

        <!-- Centred form panel -->
        <Border Grid.Row="1" Style="{StaticResource GlassPanel}"
                Margin="0,8,0,8" MaxWidth="620"
                HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel>

                <TextBlock Text="SERVER DETAILS" Style="{StaticResource PanelTitle}" Margin="0,0,0,12"/>

                <!-- Server Name -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Server Name" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ServerNameBox" Grid.Column="1" Text="My CloD Server"
                             HorizontalContentAlignment="Left"/>
                </Grid>

                <!-- Visibility Type -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Visibility" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="RadioPublic" Content="Public"
                                     IsChecked="True" GroupName="Visibility"
                                     VerticalAlignment="Center"/>
                        <RadioButton x:Name="RadioFriends" Content="Friends Only"
                                     GroupName="Visibility"
                                     VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Max Players -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Max Players" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <TextBox x:Name="MaxPlayersBox" Grid.Column="1" Text="255"
                             HorizontalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="(1 – 255)" FontSize="11"
                               Foreground="#50F2E7D7" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Password -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Password" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="PasswordBox" Grid.Column="1"
                                 PasswordChar="●" MaxLength="64"/>
                </Grid>

                <!-- Description -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Description" Style="{StaticResource LabelText}" VerticalAlignment="Top"
                               Margin="0,4,0,0"/>
                    <TextBox Grid.Column="1" Height="60"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                             Text="Welcome! Fair fights and good sportsmanship expected."/>
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource BorderBrushMuted}" Margin="0,14,0,10"/>
                <TextBlock Text="MISSION / GAME TYPE" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>

                <!-- Game Type -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Game Mode" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="0">
                        <ComboBoxItem Content="Dogfight"/>
                        <ComboBoxItem Content="Cooperative"/>
                        <ComboBoxItem Content="Campaign"/>
                        <ComboBoxItem Content="Training"/>
                    </ComboBox>
                </Grid>

                <!-- Theatre -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Theatre" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="0">
                        <ComboBoxItem Content="Battle of Britain (English Channel)"/>
                        <ComboBoxItem Content="Desert War (Tobruk)"/>
                    </ComboBox>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushMuted}"
                BorderThickness="1" Background="#88161C1F">
            <Grid Margin="18,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Button Content="← CANCEL" Height="38" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="CREATE SERVER" Height="38"
                        Style="{StaticResource OkButton}" Click="Create_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
